# --- API server (apps/api) ---------------------------------------------------
# GitHub token for public repo reads (5,000 requests/hour). A fine-grained token
# with "Public repositories (read-only)" is enough.
GITHUB_TOKEN=
# Public URL of the site (used in share links, OG images, OAuth callback).
SITE_URL=http://localhost:8787
PORT=8787
# Where dungeons, leaderboards and rendered images are stored.
CACHE_DIR=.cache/gitcrawl
# Built web app to serve (empty = API only).
WEB_DIST=../web/dist
# Comma-separated origins allowed to call the API cross-origin ("*" = any, no cookies).
CORS_ORIGIN=*
# Uncached dungeon generations per visitor IP per hour.
GENERATE_PER_HOUR=10
# Below this many GitHub calls left, the API asks browsers to build dungeons themselves.
GITHUB_RESERVE=150

# --- Private repos via a GitHub App (optional) --------------------------------
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
# Any long random string; encrypts the session cookie.
SESSION_SECRET=

# --- Web client (apps/web, build time) -----------------------------------------
# API origin if the web app is hosted separately (empty = same origin).
VITE_API_BASE=
VITE_SITE_URL=https://gitcrawl.dev
